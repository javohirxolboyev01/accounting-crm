# --- Ma'lumotlar bazasi ---
POSTGRES_DB=buxcrm
POSTGRES_USER=buxcrm
POSTGRES_PASSWORD=buxcrm_dev_password
DATABASE_URL=postgres://buxcrm:buxcrm_dev_password@localhost:5432/buxcrm
TEST_DATABASE_URL=postgres://buxcrm:buxcrm_dev_password@localhost:5432/buxcrm_test

# --- API ---
PORT=8080
NODE_ENV=development
# Frontend manzili (vergul bilan bir nechta)
CORS_ORIGIN=http://localhost:5173
# Kamida 32 belgi; prod'da albatta almashtiring
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters

# Birinchi ishga tushishda yaratiladigan rahbar (agar foydalanuvchilar bo'lmasa)
BOOTSTRAP_LEADER_LOGIN=admin
BOOTSTRAP_LEADER_PASSWORD=Admin12345!
BOOTSTRAP_LEADER_NAME=Rahbar

# --- Telegram (ixtiyoriy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Google Sheets (ixtiyoriy) ---
# Service account JSON kalit fayli yo'li
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# --- Rejalashtirilgan ishlar ---
SCHEDULER_ENABLED=true
BACKUP_ENABLED=false
BACKUP_DIR=./backups
